# LocalWheels Enterprise v1.0 — Environment Variables
# Copy to: /var/www/localwheels/backend/.env
# NEVER commit this file. It is in .gitignore.
#
# Generate secrets:
#   JWT_SECRET:           node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   METRICS_TOKEN:        node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   VOICE_ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   BACKUP_PASSPHRASE:    openssl rand -base64 32

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas M10+ connection string
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/localwheels?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://localwheels_prod:<PASSWORD>@cluster0.xxxxx.mongodb.net/localwheels?retryWrites=true&w=majority

# ── Cache ─────────────────────────────────────────────────────────────────────
# Local Redis installed by setup-vps.sh
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64-char-random-hex>
JWT_EXPIRES_IN=7d

# ── Clerk (optional — for SSO login) ─────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
# Comma-separated allowed frontend origins for Clerk token verification
CLERK_AUTHORIZED_PARTIES=https://app.yourdomain.com

# ── CORS ─────────────────────────────────────────────────────────────────────
# Must match exactly — no trailing slash
ALLOWED_ORIGINS=https://app.yourdomain.com

# ── Monitoring ────────────────────────────────────────────────────────────────
# Random token to gate GET /api/metrics from Prometheus scraper
METRICS_TOKEN=<32-char-random-hex>

# ── Encryption ────────────────────────────────────────────────────────────────
VOICE_ENCRYPTION_KEY=<32-char-random-hex>

# ── AI (optional) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
AI_TIMEOUT_MS=30000

# ── WhatsApp (optional) ───────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Customer Onboarding (used by seed-production.js — remove after seeding) ──
SEED_COMPANY_NAME=Rajdhani Cargo Services Pvt Ltd
SEED_ADMIN_USERNAME=rajdhani_admin
SEED_ADMIN_EMAIL=admin@rajdhanicargoservices.com
SEED_ADMIN_PASSWORD=<min-12-chars>

# ── Frontend URL (for links in emails / seed output) ─────────────────────────
FRONTEND_URL=https://app.yourdomain.com

# ── Backup (used by deploy/backup.sh) ────────────────────────────────────────
BACKUP_PASSPHRASE=<openssl-rand-base64-32>
