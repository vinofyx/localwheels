# LocalWheels — Hostinger Business Hosting (LiteSpeed + hPanel Node.js)
#
# ── How this works ────────────────────────────────────────────────────────────
# Express (Node.js) serves EVERYTHING: React static files + /api/* JSON.
# LiteSpeed hands all requests to the Node.js app via Passenger (configured
# in hPanel → Node.js). This file only exists as a safety net; Passenger
# intercepts requests before LiteSpeed's own rewrite engine runs.
#
# ── If hPanel Node.js is NOT yet configured ───────────────────────────────────
# Without Passenger, LiteSpeed serves static files from public_html/.
# In that mode /api/* has no backend → we return 503 Service Unavailable
# instead of silently returning index.html (which breaks the frontend).
# Configure the Node.js app in hPanel first, then these rules become moot.
# ─────────────────────────────────────────────────────────────────────────────

RewriteEngine On
RewriteBase /

# ── Block /api/* from being served as static HTML ────────────────────────────
# If Node.js/Passenger is not running, return 503 rather than index.html.
# A 503 is parseable by the frontend error handler; HTML disguised as 200 is not.
RewriteRule ^api/ - [R=503,L]
RewriteRule ^uploads/ - [R=503,L]

# ── SPA fallback (only used if Passenger is NOT active) ───────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# ── GZIP ─────────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Cache headers ─────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
</IfModule>

# ── MIME types ────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>
