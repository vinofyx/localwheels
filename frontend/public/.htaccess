# LocalWheels — Apache SPA Routing for Hostinger / cPanel
# ─────────────────────────────────────────────────────────────────────────────
# Without this file, pressing Refresh on /dashboard, /login, or any client-side
# route returns Apache 404 because no physical file exists at those paths.
# React Router handles routing inside the built index.html.
# ─────────────────────────────────────────────────────────────────────────────

Options -MultiViews
RewriteEngine On
RewriteBase /

# Pass real files/directories (assets, favicon, etc.) straight through
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Everything else → index.html (SPA entry point)
RewriteRule ^ index.html [QSA,L]

# ── Security: block dot-files (.env, .git, etc.) ─────────────────────────────
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# ── GZIP compression ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# ── Browser caching ───────────────────────────────────────────────────────────
# Vite content-hashes asset filenames — cache them forever.
# index.html has no hash — NEVER cache it (ensures fresh deploys take effect).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
</IfModule>

# ── MIME types (required for ES modules on some Apache versions) ──────────────
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
