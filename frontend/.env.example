# ── LocalWheels Frontend — Environment Variables ──────────────────────────────
# Copy to: frontend/.env  (development)
# NEVER commit a real .env file — only this .env.example is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Required if using Clerk SSO login (optional — legacy username/password works without it).
# Get from: https://dashboard.clerk.com → Your App → API Keys → Publishable key
#   Development key starts with: pk_test_
#   Production key starts with:  pk_live_
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── API URL ───────────────────────────────────────────────────────────────────
# Development:
#   DO NOT set VITE_API_URL. Vite's dev proxy (vite.config.js) forwards
#   /api/* → localhost:5000 automatically.
#
# Production (Hostinger VPS — single domain, RECOMMENDED):
#   DO NOT set VITE_API_URL. Nginx proxies /api/* → localhost:5000 on the
#   same domain. The built app falls back to relative '/api' automatically.
#   See deploy/nginx.conf for the Nginx configuration.
#
# Production (separate API subdomain):
#   Only needed if your API runs on a different domain than the frontend, e.g.:
#     https://api.yourdomain.com  (API)
#     https://yourdomain.com      (frontend)
#   In that case set:
# VITE_API_URL=https://api.yourdomain.com/api
