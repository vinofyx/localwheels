# ── LocalWheels Frontend — Environment Variables ─────────────────────────────
# Copy this file to .env.local for local development
# For production, set these in the Vercel dashboard (Settings → Environment Variables)

# Backend API base URL
# Development: leave empty (Vite dev proxy handles it)
# Production:  https://localwheels-backend.onrender.com/api
VITE_API_URL=https://your-render-backend.onrender.com/api
