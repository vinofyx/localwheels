# ── LocalWheels Frontend — Production Environment ─────────────────────────────
# This file is loaded automatically by Vite during `npm run build`.
# ─────────────────────────────────────────────────────────────────────────────
#
# Hostinger VPS deployment: Nginx serves the frontend AND proxies /api/* to
# the backend on the same domain. The relative '/api' fallback in api/client.js
# is correct — do NOT set VITE_API_URL for same-domain deployments.
#
# Only set this if your API is on a SEPARATE subdomain, e.g.:
#   VITE_API_URL=https://api.yourdomain.com/api
#
# VITE_API_URL=
