# ── LocalWheels Frontend — Production Environment ─────────────────────────────
# This file is loaded automatically by Vite during `npm run build`.
# Values here OVERRIDE frontend/.env for production builds.
# ─────────────────────────────────────────────────────────────────────────────

# ── Clerk SSO ─────────────────────────────────────────────────────────────────
# IMPORTANT: frontend/.env contains a pk_test_ (development) Clerk key.
# Dev keys only work on localhost — they CANNOT load their CDN script from a
# real production domain. On Hostinger, ClerkProvider throws a JS error that
# the ErrorBoundary catches → "Something went wrong" on the branch-select page.
#
# Setting this to empty disables Clerk in production (CLERK_ENABLED = false).
# Legacy username/password login works normally without Clerk.
#
# When ready for Clerk SSO in production:
#   1. Create a production Clerk app at https://dashboard.clerk.com
#   2. Set VITE_CLERK_PUBLISHABLE_KEY=pk_live_... below
#   3. Set CLERK_SECRET_KEY=sk_live_... in backend/.env on the VPS
#   4. Add your production domain to the Clerk app's allowed origins
VITE_CLERK_PUBLISHABLE_KEY=

# ── API URL ───────────────────────────────────────────────────────────────────
# Hostinger VPS single-domain: Nginx proxies /api/* → localhost:5000.
# Relative '/api' fallback in api/client.js works — leave this unset.
#
# Only set if API is on a separate subdomain:
#   VITE_API_URL=https://api.yourdomain.com/api
# VITE_API_URL=
