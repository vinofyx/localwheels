# ── LocalWheels Backend — PRODUCTION Environment Variables ───────────────────
# Copy this file to backend/.env on your Hostinger VPS and fill in real values.
# NEVER commit .env to git.
#
# On the VPS:
#   cp backend/.env.production.example backend/.env
#   nano backend/.env   # fill in all values
#   pm2 restart localwheels-api
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas M10+ connection string.
# Atlas → Cluster → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/localwheels?retryWrites=true&w=majority&appName=localwheels-prod

# ── Authentication ────────────────────────────────────────────────────────────
# MUST be a cryptographically random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Changing this invalidates ALL active user sessions.
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=7d

# ── CORS (Frontend Origins) ───────────────────────────────────────────────────
# Comma-separated. Must exactly match the protocol + domain + port.
# No trailing slash.
# Single-domain VPS: frontend and API share the same domain.
# Set this to https://yourdomain.com (and https://www.yourdomain.com if applicable).
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ── Redis Cache ───────────────────────────────────────────────────────────────
# Redis Cloud → Database → Configuration → Public Endpoint
# Format: redis://:password@host:port  (or rediss:// for TLS)
REDIS_URL=redis://:password@redis-xxxxx.c1.us-east-1-2.ec2.cloud.redislabs.com:12345

# ── AI (Anthropic Claude) ─────────────────────────────────────────────────────
# Powers: Lead scoring, route AI, complaint classification, finance copilot,
# voice intent recognition, document OCR, digital twin simulation.
# Degrades gracefully to rule-based fallback if unset.
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXX
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Used for: invoice delivery, password reset, complaint notifications, alerts.
# Recommended: SendGrid, AWS SES, or Postmark.
#
# SendGrid example:
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=SG.XXXXXXXXXXXXXXXXXXXX
SMTP_FROM=noreply@localwheels.com
SMTP_FROM_NAME=LocalWheels Platform

# ── WhatsApp (Twilio) ─────────────────────────────────────────────────────────
# Used for: shipment notifications, delivery alerts, customer tracking.
# Get from: twilio.com → Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── SMS Gateway ───────────────────────────────────────────────────────────────
# Used for: OTP, urgent alerts, driver notifications.
# Recommended: Twilio SMS or MSG91 (India)
SMS_PROVIDER=twilio
# MSG91 (India alternative):
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=XXXXXXXXXXXXXXXXXXXXXXXX
# MSG91_SENDER_ID=LCLWHL

# ── Object Storage (File Uploads) ─────────────────────────────────────────────
# Used for: POD photos, document uploads, OCR source files, invoice PDFs.
# Options: AWS S3, Cloudflare R2 (S3-compatible), DigitalOcean Spaces
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=localwheels-prod-uploads
# Max upload size (bytes). Default 10MB.
MAX_FILE_SIZE=10485760

# ── Payment Gateway ───────────────────────────────────────────────────────────
# Used for: customer online payments, subscription management.
# Recommended: Razorpay (India) or Stripe (global)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Stripe alternative:
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Voice Encryption ──────────────────────────────────────────────────────────
# AES-256 key for encrypting voice transcripts at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOICE_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# ── Monitoring & Observability ────────────────────────────────────────────────
# Sentry: error tracking and performance monitoring
SENTRY_DSN=https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@oXXXXXX.ingest.sentry.io/XXXXXXX

# Datadog: log aggregation (alternative to Sentry)
# DATADOG_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated trusted proxy IPs (for accurate rate limiting behind load balancer)
# AWS/Render: set to the load balancer's IP range or use "loopback"
TRUST_PROXY=1

# Session secret for any server-side sessions (currently unused — JWT-only)
# SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Disable individual integrations without code changes:
ENABLE_AI=true
ENABLE_WHATSAPP=true
ENABLE_EMAIL=true
ENABLE_SMS=false
ENABLE_PAYMENT=false
ENABLE_STORAGE=true

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=LocalWheels
APP_VERSION=1.0.0
SUPPORT_EMAIL=support@localwheels.com
SUPPORT_PHONE=+91-XXXXXXXXXX
