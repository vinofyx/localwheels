# ── LocalWheels Backend — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.
#
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: Atlas → Clusters → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/localwheels?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# MUST be a cryptographically random string in production.
# Minimum recommended: 64 bytes (128 hex characters).
#
# Generate a new secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# WARNING: using a guessable secret allows anyone to forge valid JWTs.
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production example:  https://localwheels.vercel.app
# Multiple origins:    https://localwheels.vercel.app,https://localwheels-preview.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081

# ── Optional ──────────────────────────────────────────────────────────────────
# Shown in the API root page; leave blank in development
# FRONTEND_URL=https://localwheels.vercel.app

# ── AI (Claude) ───────────────────────────────────────────────────────────────
# Used by: chat, complaint classification, route/fleet/dispatch AI, voice intent recognition.
# All AI calls degrade gracefully to rule-based fallback logic if this is unset.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Voice Agent (Phase 8) ─────────────────────────────────────────────────────
# Encrypts stored voice transcripts (AES-256). MUST be set to a random secret in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# VOICE_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_SECRET

# ── Clerk Authentication ───────────────────────────────────────────────────────
# Required only if using Clerk-based login (POST /api/auth/clerk-exchange).
# Get from: https://dashboard.clerk.com → Your App → API Keys → Secret key
# CLERK_SECRET_KEY=sk_test_...
