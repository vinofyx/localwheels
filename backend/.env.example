# ── LocalWheels Backend — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.
#
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: Atlas → Clusters → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/localwheels?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# MUST be a cryptographically random string in production.
# Minimum recommended: 64 bytes (128 hex characters).
#
# Generate a new secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# WARNING: using a guessable secret allows anyone to forge valid JWTs.
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production example:  https://localwheels.vercel.app
# Multiple origins:    https://localwheels.vercel.app,https://localwheels-preview.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Optional ──────────────────────────────────────────────────────────────────
# Shown in the API root page; leave blank in development
# FRONTEND_URL=https://localwheels.vercel.app
