{
  "title": "LocalWheels — Production Overview",
  "uid": "lw-prod-overview",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["localwheels", "production"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API Uptime",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "up{job='localwheels-api'}", "legendFormat": "Up" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "DB Status",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "mongodb_up", "legendFormat": "MongoDB" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "CONNECTED", "color": "green" } } }]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 Latency",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(process_http_duration_seconds_bucket[5m])) * 1000", "legendFormat": "P95 ms" }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 300 }, { "color": "red", "value": 500 }] }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Rate",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "rate(process_http_requests_total{status_code=~'5..'}[5m]) / rate(process_http_requests_total[5m]) * 100", "legendFormat": "5xx %" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Heap Used",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "process_heap_used_bytes / 1024 / 1024", "legendFormat": "Heap MB" }],
      "fieldConfig": { "defaults": { "unit": "megabytes" } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Requests/min",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "rate(process_http_requests_total[1m]) * 60", "legendFormat": "req/min" }],
      "fieldConfig": { "defaults": { "unit": "reqpm" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Request Rate by Method",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(process_http_requests_total{method='GET'}[1m]) * 60", "legendFormat": "GET" },
        { "expr": "rate(process_http_requests_total{method='POST'}[1m]) * 60", "legendFormat": "POST" },
        { "expr": "rate(process_http_requests_total{method='PUT'}[1m]) * 60", "legendFormat": "PUT" },
        { "expr": "rate(process_http_requests_total{method='DELETE'}[1m]) * 60", "legendFormat": "DELETE" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Response Time Percentiles",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(process_http_duration_seconds_bucket[5m])) * 1000", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, rate(process_http_duration_seconds_bucket[5m])) * 1000", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, rate(process_http_duration_seconds_bucket[5m])) * 1000", "legendFormat": "P99" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "P95" }, "properties": [{ "id": "custom.lineWidth", "value": 2 }] }
        ]
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Error Rate (5xx)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(process_http_requests_total{status_code=~'5..'}[5m]) * 60", "legendFormat": "5xx/min" },
        { "expr": "rate(process_http_requests_total{status_code=~'4..'}[5m]) * 60", "legendFormat": "4xx/min" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Node.js Memory",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "process_resident_memory_bytes / 1024 / 1024", "legendFormat": "RSS MB" },
        { "expr": "process_heap_used_bytes / 1024 / 1024", "legendFormat": "Heap Used MB" },
        { "expr": "process_heap_total_bytes / 1024 / 1024", "legendFormat": "Heap Total MB" }
      ],
      "fieldConfig": { "defaults": { "unit": "megabytes" } }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Top API Routes — Latency P95",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "targets": [
        { "expr": "topk(10, histogram_quantile(0.95, rate(process_http_duration_seconds_bucket[5m])) * 1000) by (route)", "legendFormat": "{{ route }}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    }
  ]
}
